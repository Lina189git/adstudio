generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid()) @map("_id")
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               String          @id @default(cuid()) @map("_id")
  name             String
  slug             String          @unique
  description      String?
  shortDescription String?
  basePriceCents   Int
  currency         String          @default("usd")
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id])
  imageUrl         String?
  galleryImages    String[]
  isActive         Boolean         @default(true)
  isFeatured       Boolean         @default(false)
  stockQuantity    Int             @default(0)
  variants         ProductVariant[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  // ── Advertisement / commission fields ──────────────────────────────────────
  commissionType   String          @default("PERCENTAGE") // "PERCENTAGE" | "FIXED"
  commissionRate   Float           @default(0.10)         // e.g. 0.15 = 15%
  commissionFixed  Int             @default(0)            // cents, used when type=FIXED
  sampleStock      Int             @default(0)            // samples available to ship
  taskRequirements String?                                // what the ad video must cover
  applications     AdApplication[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model ProductVariant {
  id              String     @id @default(cuid()) @map("_id")
  productId       String
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  sku             String     @unique
  canvasSize      String
  frameStyle      String
  previewImageUrl String?
  details         String?
  priceCents      Int
  stockQuantity   Int        @default(0)
  isActive        Boolean    @default(true)
  orderItems      OrderItem[]
  cartItems       CartItem[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model OrderItem {
  id              String         @id @default(cuid()) @map("_id")
  orderId         String
  order           PaintingOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  quantity        Int            @default(1)
  unitPriceCents  Int
  totalPriceCents Int
  customImageUrl  String?
  customStylePreset String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model PaintingOrder {
  id                      String      @id @default(cuid()) @map("_id")
  reference               String      @unique
  customerName            String
  email                   String
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id])
  sourceImageUrl          String?
  sourcePublicId          String?
  previewUrl              String?
  stylePreset             String?
  mode                    String      @default("CUSTOM")
  canvasSize              String?
  frameStyle              String?
  quantity                Int         @default(1)
  orderItems              OrderItem[]
  subtotalCents           Int         @default(0)
  taxCents                Int         @default(0)
  shippingCents           Int         @default(0)
  discountCents           Int         @default(0)
  amountCents             Int
  currency                String      @default("usd")
  status                  String      @default("PENDING_PAYMENT")
  paymentStatus           String      @default("PENDING")
  stripeCheckoutSessionId String?
  trackingNumber          String?
  notes                   String?
  timelineEstimate        String?
  shareToGallery          Boolean     @default(false)
  galleryTitle            String?
  galleryDisplayName      String?
  isFeatured              Boolean     @default(false)
  sharedAt                DateTime?
  paidAt                  DateTime?
  shippingAddress         Json?
  billingAddress          Json?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
}

model Frame {
  id             String   @id @default(cuid()) @map("_id")
  name           String
  slug           String   @unique
  description    String?
  imageUrl       String?
  availableSizes String[]
  priceCents     Int      @default(0)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AIPaintingSession {
  id          String   @id @default(cuid()) @map("_id")
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  stylePreset String   @default("monet")
  prompt      String?
  status      String   @default("COMPLETED")
  errorMessage String?
  model       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String              @id @default(cuid()) @map("_id")
  name               String?
  email              String              @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  role               UserRole            @default(USER)
  accounts           Account[]
  sessions           Session[]
  orders             PaintingOrder[]
  cartItems          CartItem[]
  aiSessions         AIPaintingSession[]
  artistCommissions  CommissionRequest[] @relation("ArtistCommissions")
  userCommissions    CommissionRequest[] @relation("UserCommissions")
  workUpdates        WorkUpdate[]        @relation("ArtistWorkUpdates")
  // Influencer relations
  influencerProfile  InfluencerProfile?
  applications       AdApplication[]    @relation("InfluencerApplications")
  adTasks            AdTask[]           @relation("InfluencerTasks")
  videoSubmissions   VideoSubmission[]  @relation("InfluencerVideos")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model VerificationToken {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Shopping Cart ───────────────────────────────────────────────────────────

model CartItem {
  id        String         @id @default(cuid()) @map("_id")
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, productId, variantId])
}

// ─── Legacy Commission (painting studio) ─────────────────────────────────────

model CommissionRequest {
  id               String          @id @default(cuid()) @map("_id")
  reference        String          @unique
  customerName     String
  email            String
  phone            String?
  paintingType     String
  size             String
  surface          String
  style            String
  quantity         String
  deadline         String?
  budget           String?
  deliveryCity     String?
  notes            String?
  referenceImageUrls String[]
  estimatedRange   String?
  timeline         String?
  status           CommissionStatus @default(PENDING)
  adminNotes       String?
  assignedArtistId String?
  assignedArtist   User?           @relation("ArtistCommissions", fields: [assignedArtistId], references: [id])
  userId           String?
  user             User?           @relation("UserCommissions", fields: [userId], references: [id])
  workUpdates      WorkUpdate[]
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model WorkUpdate {
  id                  String            @id @default(cuid()) @map("_id")
  commissionId        String
  commission          CommissionRequest  @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  artistId            String
  artist              User              @relation("ArtistWorkUpdates", fields: [artistId], references: [id])
  title               String
  description         String?
  imageUrls           String[]
  videoUrls           String[]
  step                String
  isVisibleToCustomer Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

// ─── Influencer Platform ──────────────────────────────────────────────────────

model InfluencerProfile {
  id              String   @id @default(cuid()) @map("_id")
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String?
  website         String?
  instagram       String?
  youtube         String?
  tiktok          String?
  twitter         String?
  followerCount   Int?
  niche           String[]
  country         String?
  city            String?
  shippingAddress Json?    // { name, address1, address2, city, state, zip, country }
  isApproved      Boolean  @default(false)
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdApplication {
  id             String            @id @default(cuid()) @map("_id")
  ref            String            @unique @default(cuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  influencerId   String
  influencer     User              @relation("InfluencerApplications", fields: [influencerId], references: [id])
  status         ApplicationStatus @default(PENDING)
  pitch          String?           // why they want to promote this product
  plannedContent String?           // description of the video they plan to make
  contactInfo    Json?             // { phone, email, platforms[], handles{}, followerRange, bio }
  agreedRate     Float?            // confirmed commission % (e.g. 0.12)
  agreedAmount   Int?              // OR fixed amount in cents
  adminNotes     String?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  sample         ProductSample?
  task           AdTask?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model ProductSample {
  id              String         @id @default(cuid()) @map("_id")
  applicationId   String         @unique
  application     AdApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  trackingNumber  String?
  carrier         String?
  shippingAddress Json?
  status          ShippingStatus @default(PREPARING)
  shippedAt       DateTime?
  deliveredAt     DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model AdTask {
  id            String      @id @default(cuid()) @map("_id")
  ref           String      @unique @default(cuid())
  applicationId String      @unique
  application   AdApplication @relation(fields: [applicationId], references: [id])
  productId     String
  influencerId  String
  influencer    User        @relation("InfluencerTasks", fields: [influencerId], references: [id])
  readme        String?     // task brief issued by admin
  requirements  String[]
  deadline      DateTime?
  status        TaskStatus  @default(ACTIVE)
  videos        VideoSubmission[]
  payment       CommissionPayment?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model VideoSubmission {
  id            String      @id @default(cuid()) @map("_id")
  taskId        String
  task          AdTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  influencerId  String
  influencer    User        @relation("InfluencerVideos", fields: [influencerId], references: [id])
  videoUrl      String
  thumbnailUrl  String?
  title         String
  description   String?
  status        VideoStatus @default(PENDING_REVIEW)
  adminComment  String?
  approvedAt    DateTime?
  isPublic      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model CommissionPayment {
  id           String        @id @default(cuid()) @map("_id")
  taskId       String        @unique
  task         AdTask        @relation(fields: [taskId], references: [id])
  influencerId String
  amountCents  Int
  status       PaymentStatus @default(PENDING)
  paymentRef   String?
  paidAt       DateTime?
  approvedBy   String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  ARTIST
  INFLUENCER
  VISITOR
  READER
  AUTHOR
  COAUTHOR
}

enum CommissionStatus {
  PENDING
  QUOTED
  APPROVED
  ASSIGNED
  IN_PROGRESS
  REVIEW
  REVISION
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ShippingStatus {
  PREPARING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum TaskStatus {
  ACTIVE
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  COMPLETED
  CANCELLED
}

enum VideoStatus {
  PENDING_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
  PUBLISHED
}

enum PaymentStatus {
  PENDING
  APPROVED
  PAID
  FAILED
}
